---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";

import ConfigCarrier from "@components/ConfigCarrier.astro";
import { Icon } from "astro-icon/components";
import { announcementConfig, profileConfig, siteConfig } from "@/config";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import "katex/dist/katex.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
}

let { title, banner, description, lang, setOGTypeArticle } = Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

// TODO don't use post cover as banner for now
banner = siteConfig.banner.src;

const enableBanner = siteConfig.banner.enable;
const meteorShowerConfig = siteConfig.meteorShower;
const meteorEnabled = meteorShowerConfig.enable;
const meteorCount = Math.min(
	Math.max(meteorShowerConfig.meteorCount ?? 6, 0),
	12,
);
const meteorBrightness = Math.min(
	Math.max(meteorShowerConfig.brightness ?? 1, 0.8),
	1.6,
);
const meteorBaseDurationSec = Math.min(
	Math.max(meteorShowerConfig.baseDurationSec ?? 15, 10),
	24,
);

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = siteConfig.title;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] text-[14px] md:text-[16px]"
	  data-overlayscrollbars-initialize
>
	<head>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || pageTitle}>
		<meta name="author" content={profileConfig.name}>

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description || pageTitle}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description || pageTitle}>

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}
		{siteConfig.umamiEnabled && <script defer src="https://cloud.umami.is/script.js" data-website-id="ae67fee2-0f2a-46b9-bfde-d495c8334931"></script>}
		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHue, forceDarkMode: siteConfig.themeColor.forceDarkMode, useTransparentCards: meteorEnabled}}>
			// Lock interactions before first paint/load to avoid premature scroll/click.
			document.documentElement.classList.add('is-page-lock');
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const saveDataEnabled = navigator.connection && navigator.connection.saveData;
			// 仅当用户明确开启减少动画或省流量模式时才进入 low-perf。
			if (prefersReducedMotion || saveDataEnabled) {
				document.documentElement.classList.add('low-perf');
			}
			// Check if force dark mode is enabled
			if (forceDarkMode) {
				// Force dark mode regardless of user preference
				document.documentElement.classList.add('dark');
			} else {
				// Load the theme from local storage
				const theme = localStorage.getItem('theme') || DEFAULT_THEME;
				switch (theme) {
					case LIGHT_MODE:
						document.documentElement.classList.remove('dark');
						break
					case DARK_MODE:
						document.documentElement.classList.add('dark');
						break
					case AUTO_MODE:
						if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
							document.documentElement.classList.add('dark');
						} else {
							document.documentElement.classList.remove('dark');
						}
						break;
				}
			}

			// Load the hue from local storage
			const hue = localStorage.getItem('hue') || configHue;
			const r = document.documentElement;
			r.style.setProperty('--hue', hue);

			// 预设关键 CSS 变量（page-bg/card-bg 等），避免等待 main.css 异步加载导致 FOUC
			// 这些值与 variables.styl 的定义保持一致，main.css 加载后会覆盖（值相同所以无闪烁）
			const isDark = r.classList.contains('dark');
			const H = hue;
			r.style.setProperty('--page-bg', isDark ? `oklch(0.16 0.014 ${H})` : `oklch(0.95 0.01 ${H})`);
			r.style.setProperty('--card-bg', isDark ? `oklch(0.23 0.015 ${H})` : 'white');
			r.style.setProperty('--btn-regular-bg', isDark ? `oklch(0.33 0.035 ${H})` : `oklch(0.95 0.025 ${H})`);
			r.style.setProperty('--float-panel-bg', isDark ? `oklch(0.19 0.015 ${H})` : 'white');

			// Load the custom background setting before paint (video src set later by loadCustomBg)
			const customBgEnabled = localStorage.getItem('custom-bg-enabled') === 'true';
			const customBgUrl = localStorage.getItem('custom-bg-url') || '';
			if (customBgEnabled && customBgUrl.trim()) {
				r.classList.add('custom-bg-active');
			}

			// Load the custom background gaussian blur strength before paint (avoid FOUC)
			const customBgBlur = localStorage.getItem('custom-bg-blur');
			if (customBgBlur !== null) {
				r.style.setProperty('--custom-bg-blur', `${customBgBlur}px`);
				// 纯数字变量用于 scale() 边缘遮盖计算（兼容旧版浏览器 calc）
				r.style.setProperty('--custom-bg-blur-num', customBgBlur);
			}

			// Load the gaussian blur target (card / bg) before paint (avoid FOUC)
			r.dataset.blurTarget = localStorage.getItem('custom-bg-blur-target') || 'card';

			// Load the gaussian blur switch state before paint (avoid FOUC)
			// 关闭开关后必须移除模糊效果，因此 CSS 规则以 data-blur-enabled 为前提
			r.dataset.blurEnabled = localStorage.getItem('custom-bg-blur-enabled') === 'true' ? 'true' : 'false';

			// Load the announcement float switch state before paint (avoid FOUC)
			r.dataset.announcementEnabled = localStorage.getItem('announcement-enabled') === 'false' ? 'false' : 'true';

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);

			// Keep the original "slightly transparent card" feel when background effects are enabled.
			if (useTransparentCards) {
				document.documentElement.style.setProperty('--card-bg', 'var(--card-bg-transparent)');
				document.documentElement.style.setProperty('--float-panel-bg', 'var(--float-panel-bg-transparent)');
			}
		</script>
		<style define:vars={{ 'page-width': `${PAGE_WIDTH}rem`, 'meteor-brightness': meteorBrightness, 'meteor-base-duration': `${meteorBaseDurationSec}s` }}>
			:root {
				--page-width: var(--page-width);
				/* 自定义背景高斯模糊强度（px），默认 18px 让毛玻璃在深色背景下清晰可见 */
				--custom-bg-blur: 18px;
				/* 纯数字副本：用于 transform: scale() 边缘遮盖计算（filter 用带单位变量） */
				--custom-bg-blur-num: 18;
			}

			body {
				position: relative;
				/* 注意：不能加 isolation: isolate。
				 * 自定义背景层（custom-bg-video/img）被 detach 到 <html> 下，
				 * 若 body 创建独立层叠上下文（backdrop root），卡片 backdrop-filter
				 * 将采样不到 body 外的背景层，导致“操作卡片”模糊在 Chrome 中无效。 */
				background: transparent;
			}

			/* 深色渐变底 + 光晕必须放在 <html>（最底层）而不是 <body>：
			 * body 是定位元素（position:relative, z-index:auto），按 CSS 绘制顺序
			 * 其背景会绘制在负 z-index 后代（流星 z:-1、星点/光晕 z:-2）之上，
			 * 导致流星雨在 Chrome/Firefox 中被 body 不透明背景完全盖住而不可见。
			 * 移到 html 后层级为：html 底 → 星点/光晕(z:-2) → 流星(z:-1) → 内容。 */
			html {
				background-image:
					radial-gradient(circle at 15% 18%, rgba(56, 189, 248, 0.18), transparent 42%),
					radial-gradient(circle at 82% 24%, rgba(125, 211, 252, 0.14), transparent 40%),
					linear-gradient(180deg, #0a1024 0%, #101833 45%, #121d3a 100%);
			}

			body::before {
				content: "";
				position: fixed;
				inset: 0;
				z-index: -2;
				pointer-events: none;
				opacity: calc(0.55 * var(--meteor-brightness));
			background-image:
				radial-gradient(1.5px 1.5px at 8% 12%, rgba(255, 255, 255, 0.85) 100%, transparent 0),
				radial-gradient(2px 2px at 22% 38%, rgba(255, 255, 255, 0.7) 100%, transparent 0),
				radial-gradient(1.5px 1.5px at 38% 18%, rgba(255, 255, 255, 0.9) 100%, transparent 0),
				radial-gradient(2px 2px at 55% 45%, rgba(255, 255, 255, 0.65) 100%, transparent 0),
				radial-gradient(1.5px 1.5px at 72% 12%, rgba(255, 255, 255, 0.8) 100%, transparent 0),
				radial-gradient(2px 2px at 88% 32%, rgba(255, 255, 255, 0.7) 100%, transparent 0),
				radial-gradient(1.5px 1.5px at 15% 65%, rgba(255, 255, 255, 0.85) 100%, transparent 0),
				radial-gradient(2px 2px at 45% 78%, rgba(255, 255, 255, 0.6) 100%, transparent 0),
				radial-gradient(1.5px 1.5px at 78% 72%, rgba(255, 255, 255, 0.75) 100%, transparent 0),
				radial-gradient(2px 2px at 92% 88%, rgba(255, 255, 255, 0.85) 100%, transparent 0),
				radial-gradient(1.5px 1.5px at 30% 92%, rgba(255, 255, 255, 0.7) 100%, transparent 0),
				radial-gradient(2px 2px at 62% 55%, rgba(255, 255, 255, 0.65) 100%, transparent 0);
			background-size: 240px 240px;
			background-repeat: repeat;
			}

			body::after {
				content: "";
				position: fixed;
				inset: 0;
				z-index: -2;
				pointer-events: none;
				background: radial-gradient(circle at 50% 35%, rgba(191, 219, 254, calc(0.08 * var(--meteor-brightness))), transparent 68%);
			}
		</style>


		<slot name="head"></slot>

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>

		<link rel="stylesheet" href="/src/styles/main.css" />
		<link rel="stylesheet" href="/src/styles/transition.css" />

	</head>
	<body class=" min-h-screen " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}
		  data-overlayscrollbars-initialize
	>
		<ConfigCarrier></ConfigCarrier>
		<!-- 自定义背景层：<img> 不受 ORB 限制，<video> 用于视频背景 -->
		<video id="custom-bg-video" class="custom-bg-video" muted loop playsinline aria-hidden="true"></video>
		<img id="custom-bg-img" class="custom-bg-img" alt="" referrerpolicy="no-referrer" aria-hidden="true" />
		<slot />

		<!-- 浮动公告 -->
		{announcementConfig.enable && (
			<div class="announcement-float" id="announcement-float">
				<!-- 公告图标按钮 -->
				<button class="announcement-btn" id="announcement-btn" aria-label="公告">
					<Icon name="material-symbols:campaign" class="text-xl" />
					<span class="announcement-dot" id="announcement-dot"></span>
				</button>
				
				<!-- 公告内容面板 -->
				<div class="announcement-panel" id="announcement-panel">
					<div class="announcement-header">
						<span class="font-bold">公告</span>
						<button class="announcement-close" id="announcement-close" aria-label="关闭">
							<Icon name="material-symbols:close" class="text-lg" />
						</button>
					</div>
					<div class="announcement-body" id="announcement-body">
					</div>
					<div class="announcement-footer">
						<button class="announcement-read-btn" id="announcement-read-btn" aria-label="标记已读">
							<Icon name="material-symbols:check" class="text-lg" />
							<span id="read-btn-text">标记已读</span>
						</button>
						<button class="announcement-unread-btn hidden" id="announcement-unread-btn" aria-label="标记未读">
							<Icon name="material-symbols:undo" class="text-lg" />
							<span>标记未读</span>
						</button>
					</div>
				</div>
			</div>
		)}

		        <!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		        <div id="page-height-extend" class="hidden h-[300vh]"></div>
		
		        <!-- 流星雨效果容器 -->
		        {meteorEnabled && meteorCount > 0 && (
		        	<div class="meteor-shower" id="meteor-shower" aria-hidden="true">
		        		{Array.from({ length: meteorCount }).map(() => <span class="meteor"></span>)}
		        	</div>
		        )}
		    </body></html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
}}>
@tailwind components;
@layer components {
	.enable-banner.is-home #banner-wrapper {
		@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)]
	}
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}

	.enable-banner.is-home #banner {
		@apply h-[var(--banner-height-home)] translate-y-0
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner.is-home #main-grid {
		@apply translate-y-[var(--banner-height-extend)];
	}
	.enable-banner #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-all duration-300
	}
	.enable-banner.is-home #sidebar-sticky {
		@apply top-[calc(1rem_-_var(--banner-height-extend))]
	}
	.navbar-hidden {
		@apply opacity-0 -translate-y-16
	}
}

/**
 * 自定义背景层（视频或图片）
 * 用户在齿轮面板粘贴视频/图片链接，作为整页背景替代流星雨。
 * video 用 <video> 标签，img 用 <img> 标签，均 object-fit:cover。
 * 共用 fixed 全屏布局，z-index:-2。默认 display:none。
 */
.custom-bg-video,
.custom-bg-img {
	position: fixed;
	/* inset 四向 + 百分比尺寸：fixed 元素相对视口定位，
	 * width/height:100% 对替换元素（img/video）也强制生效，
	 * 不依赖 vw/vh/dvw/dvh 单位解析——移动端地址栏、旧浏览器、
	 * 诡异比例图片都不会导致“完整显示/没铺满/错位”。
	 * （背景元素已被 detach 到 <html> 下，fixed 包含块始终是视口，
	 *   不受 OverlayScrollbars 包装 body 影响。） */
	inset: 0;
	width: 100%;
	height: 100%;
	/* Tailwind Preflight 会给 img 加 max-width:100%；背景必须
	 * 覆盖为 none，否则视口/滚动条宽度差异时背景被压回父容器
	 * 宽度，造成“没铺满/错位”（移动端尤其明显）。 */
	max-width: none;
	object-fit: cover;
	z-index: -2;
	pointer-events: none;
	display: none;
	background: transparent;
	/* 高斯模糊与边缘遮盖 scale 按“模糊对象”条件应用，见下方
	 * html[data-blur-target="bg"] 规则（兼容未设置属性时的旧行为）。 */
}

html.custom-bg-active .custom-bg-video,
html.custom-bg-active .custom-bg-img {
	display: block;
}

/* 模糊对象 = 背景（图片/视频 / 默认流星雨星点背景）：
 * 对自定义背景层应用高斯模糊（filter:blur() 兼容 Chrome 53+ / Firefox 35+ / Safari 9.1+），
 * 配合动态 scale 放大遮盖模糊产生的边缘透明区；scale 使用纯数字变量避免 px 混用解析失败。
 * 所有规则以 html[data-blur-enabled="true"] 为前提：关闭模糊开关后效果必须真正消失。
 * html:not([data-blur-target]) 兼容旧版本用户（未设置模糊对象时保持原行为：模糊背景）。
 * [data-blur-target="both"] = 背景与卡片同时模糊，继承本组背景模糊规则。
 * 仅 bg / both 模式模糊背景；card 模式保持背景清晰，只由卡片 backdrop-filter 产生毛玻璃。
 * 未开启自定义壁纸时，默认背景（星点 body::before + 流星 meteor-shower）同样参与模糊，
 * 使高斯模糊开关不依赖自定义壁纸即可生效。 */
html[data-blur-enabled="true"][data-blur-target="bg"] .custom-bg-video,
html[data-blur-enabled="true"][data-blur-target="bg"] .custom-bg-img,
html[data-blur-enabled="true"][data-blur-target="both"] .custom-bg-video,
html[data-blur-enabled="true"][data-blur-target="both"] .custom-bg-img,
html[data-blur-enabled="true"]:not([data-blur-target]) .custom-bg-video,
html[data-blur-enabled="true"]:not([data-blur-target]) .custom-bg-img {
	filter: blur(var(--custom-bg-blur, 18px));
	/* 遮盖系数 /150：blur 半径 r 需要边缘至少多出 r px 才不露边。
	 * 旧值 /250（blur 18 → 每边仅 14px < 18px）在移动端高 DPR
	 * 下边缘明显露缝，此为修复。 */
	transform: scale(calc(1 + var(--custom-bg-blur-num, 18) / 150));
	will-change: transform, filter;
}

/* 未开启自定义壁纸时，默认背景层（星点/流星/光晕）跟随模糊，开关独立可用 */
html[data-blur-enabled="true"][data-blur-target="bg"]:not(.custom-bg-active) body::before,
html[data-blur-enabled="true"][data-blur-target="bg"]:not(.custom-bg-active) body::after,
html[data-blur-enabled="true"][data-blur-target="bg"]:not(.custom-bg-active) .meteor-shower,
html[data-blur-enabled="true"][data-blur-target="both"]:not(.custom-bg-active) body::before,
html[data-blur-enabled="true"][data-blur-target="both"]:not(.custom-bg-active) body::after,
html[data-blur-enabled="true"][data-blur-target="both"]:not(.custom-bg-active) .meteor-shower {
	filter: blur(var(--custom-bg-blur, 18px));
}

/* 模糊对象 = 操作卡片 / 背景+卡片：
 * 卡片切换为半透明背景（复用流星雨开启时的透明变量），配合 backdrop-filter
 * 形成毛玻璃卡片效果；强度同样由 --custom-bg-blur 控制。
 * [data-blur-target="both"] 与 [data-blur-target="card"] 共用本组卡片规则。
 * 同样以 html[data-blur-enabled="true"] 为前提，关闭开关后卡片恢复不透明。 */
html[data-blur-enabled="true"][data-blur-target="card"],
html[data-blur-enabled="true"][data-blur-target="both"] {
	--card-bg: var(--card-bg-transparent);
	--float-panel-bg: var(--float-panel-bg-transparent);
}

html[data-blur-enabled="true"][data-blur-target="card"] .card-base,
html[data-blur-enabled="true"][data-blur-target="card"] .float-panel,
html[data-blur-enabled="true"][data-blur-target="both"] .card-base,
html[data-blur-enabled="true"][data-blur-target="both"] .float-panel {
	-webkit-backdrop-filter: blur(var(--custom-bg-blur, 12px));
	backdrop-filter: blur(var(--custom-bg-blur, 12px));
}

/* 评论区高斯模糊：跟随现有高斯模糊开关与强度，呈现与操作卡片一致的毛玻璃效果。
 * [data-blur-target="card"] / "both" 时，给评论区容器叠加半透明背景 + backdrop-filter，
 * 使 giscus 评论区（含 iframe 背景层）独立呈现毛玻璃；关闭开关或其它对象时恢复原状。 */
html[data-blur-enabled="true"][data-blur-target="card"] .comment-glass,
html[data-blur-enabled="true"][data-blur-target="both"] .comment-glass {
	background: var(--card-bg-transparent);
	border-radius: var(--radius-large);
	padding: 1rem;
	-webkit-backdrop-filter: blur(var(--custom-bg-blur, 12px));
	backdrop-filter: blur(var(--custom-bg-blur, 12px));
}

/* 开启自定义背景时，隐藏原生流星雨/星点/光晕，让自定义背景成为唯一背景 */
html.custom-bg-active .meteor-shower,
html.custom-bg-active body::before,
html.custom-bg-active body::after {
	display: none;
}

/* 开启自定义背景时，清除 body 的不透明深色渐变背景。
 * img/video 被 detachCustomBgFromBody() 移到 <html> 下（z-index:-2），
 * 若 body 保留不透明背景，会遮挡住 z-index:-2 的自定义背景层。 */
html.custom-bg-active body {
	background: transparent;
}

.meteor-shower {
	position: fixed;
	inset: 0;
	overflow: hidden;
	pointer-events: none;
	z-index: -1;
	contain: strict;
}

/* 流星雨不再跟随 low-perf（系统"减少动态效果"）隐藏：
   仅由自定义背景强制覆盖（见上方 html.custom-bg-active .meteor-shower）。
   流星雨为纯 CSS 动画、无网络请求，reduced-motion 下保留可满足用户预期。 */

html.is-page-lock,
html.is-page-lock body {
	overflow: hidden !important;
}

html.is-page-lock body * {
	pointer-events: none !important;
}

.meteor {
	position: absolute;
	left: -12vw;
	width: clamp(78px, 10vw, 150px);
	height: 2px;
	border-radius: 9999px;
	opacity: 0;
	transform: translate3d(0, 0, 0) rotate(18deg);
	will-change: transform, opacity;
	background: linear-gradient(90deg, rgba(125, 211, 252, 0), rgba(186, 230, 253, 0.95), rgba(56, 189, 248, 0));
	animation-name: meteor-slide;
