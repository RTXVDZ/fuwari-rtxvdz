	box-shadow: 0 0 8px rgba(125, 211, 252, 0.7);
}

.meteor:nth-child(1) { top: -8%; animation-duration: calc(var(--meteor-base-duration) * 1); animation-delay: -1.2s; }
.meteor:nth-child(2) { top: 2%; animation-duration: calc(var(--meteor-base-duration) * 0.9); animation-delay: -4.1s; }
.meteor:nth-child(3) { top: 12%; animation-duration: calc(var(--meteor-base-duration) * 1.06); animation-delay: -7.6s; }
