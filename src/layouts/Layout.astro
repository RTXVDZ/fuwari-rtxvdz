.meteor:nth-child(12) { top: 68%; animation-duration: calc(var(--meteor-base-duration) * 0.94); animation-delay: -12.7s; }

@keyframes meteor-slide {
	0% {
		opacity: 0;
		transform: translate3d(-6vw, -10vh, 0) rotate(18deg);
	}
	10% {
