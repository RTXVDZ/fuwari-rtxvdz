    @keyframes pulse {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }
        50% {
            transform: scale(1.2);
            opacity: 0.8;
        }
    }
    
    .announcement-panel {
        position: absolute;
        right: 70px;
        top: 50%;
        transform: translateY(-50%) translateX(10px);
        width: 280px;
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: all 0.3s ease;
    }
    
    .announcement-panel.show {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(-50%) translateX(0);
    }

    html.low-perf .announcement-dot {
        animation: none;
    }

    html.low-perf .announcement-btn,
    html.low-perf .announcement-panel {
        transition: opacity 0.15s ease, transform 0.15s ease;
    }
    
    .announcement-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }
    
    .announcement-close,
    .announcement-read-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: #666;
        padding: 4px;
        border-radius: 4px;
        transition: all 0.2s;
    }
    
    .announcement-close:hover,
    .announcement-read-btn:hover:not(:disabled) {
        background: rgba(0, 0, 0, 0.1);
        color: #333;
    }
    
    .announcement-body {
        padding: 16px;
        white-space: pre-wrap;
        line-height: 1.6;
        color: #333;
        max-height: 300px;
        overflow-y: auto;
        word-break: break-word;
    }
    
    .announcement-body :global(a) {
        color: var(--primary) !important;
        text-decoration: underline !important;
    }
    
    .announcement-body :global(a:hover) {
        opacity: 0.8;
        text-decoration: underline !important;
    }
    
    .announcement-dot.hidden {
        display: none;
    }
    
    .announcement-read-btn {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 10px 16px;
        border: none;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
        background: transparent;
        color: #22c55e;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.2s;
    }
    
    .announcement-read-btn:hover:not(:disabled) {
        background: rgba(34, 197, 94, 0.1);
    }
    
    .announcement-read-btn:disabled {
        color: #9ca3af;
        cursor: not-allowed;
    }
    
    .announcement-read-btn.read {
        color: #22c55e;
    }
    
    .announcement-footer {
        display: flex;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
    }
    
    .announcement-read-btn,
    .announcement-unread-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 10px 16px;
        border: none;
        background: transparent;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.2s;
    }
    
    .announcement-unread-btn {
        color: #f59e0b;
        border-left: 1px solid rgba(0, 0, 0, 0.1);
    }
    
    .announcement-unread-btn:hover {
        background: rgba(245, 158, 11, 0.1);
    }
    
    .announcement-unread-btn.hidden {
        display: none;
    }
</style>

<script define:vars={{ announcementText: announcementConfig.text }}>
    document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('announcement-btn');
        const panel = document.getElementById('announcement-panel');
        const closeBtn = document.getElementById('announcement-close');
        const readBtn = document.getElementById('announcement-read-btn');
        const unreadBtn = document.getElementById('announcement-unread-btn');
        const float = document.getElementById('announcement-float');
        const dot = document.getElementById('announcement-dot');
        const readBtnText = document.getElementById('read-btn-text');
        const bodyEl = document.getElementById('announcement-body');
        
        // 处理换行符 \n
        if (bodyEl) {
            const formattedText = announcementText
                .replace(/\n/g, '<br>')
                .replace(/<a /g, '<a style="color: var(--primary); text-decoration: underline;" ');
            bodyEl.innerHTML = formattedText;
        }
        
        let isOpen = false;
        let isRead = false;
        
        function hashStr(str) {
            let hash = 0;
            for (let i = 0; i < str.length; i++) {
                const char = str.charCodeAt(i);
                hash = ((hash << 5) - hash) + char;
                hash = hash & hash;
            }
            return hash.toString(36);
        }
        
        const currentHash = hashStr(announcementText);
        const STORAGE_KEY = 'announcement_read_hash';
        
        function updateUI() {
            if (isRead) {
                dot?.classList.add('hidden');
                if (readBtnText) readBtnText.textContent = '已经读啦！';
                if (readBtn) {
                    readBtn.classList.add('read');
                    readBtn.disabled = true;
                }
                if (unreadBtn) unreadBtn.classList.remove('hidden');
            } else {
                dot?.classList.remove('hidden');
                if (readBtnText) readBtnText.textContent = '标记已读';
                if (readBtn) {
                    readBtn.classList.remove('read');
                    readBtn.disabled = false;
                }
                if (unreadBtn) unreadBtn.classList.add('hidden');
            }
        }
        
        function checkAnnouncementRead() {
            const storedHash = localStorage.getItem(STORAGE_KEY);
            if (storedHash === currentHash) {
                isRead = true;
            } else {
                isRead = false;
            }
            updateUI();
        }
        
        function markAsRead() {
            if (isRead) return;
            localStorage.setItem(STORAGE_KEY, currentHash);
            isRead = true;
            updateUI();
            isOpen = false;
            panel?.classList.remove('show');
        }
        
        function markAsUnread() {
            localStorage.removeItem(STORAGE_KEY);
            isRead = false;
            updateUI();
        }
        
        function showPanel() {
            isOpen = true;
            panel?.classList.add('show');
        }
        
        checkAnnouncementRead();
        
        if (!isRead) {
            showPanel();
        }
        
        btn?.addEventListener('click', () => {
            isOpen = !isOpen;
            panel?.classList.toggle('show', isOpen);
        });
        
        closeBtn?.addEventListener('click', () => {
            isOpen = false;
            panel?.classList.remove('show');
        });
        
        readBtn?.addEventListener('click', () => {
            markAsRead();
        });
        
        unreadBtn?.addEventListener('click', () => {
            markAsUnread();
        });
        
        document.addEventListener('click', (e) => {
            if (isOpen && !float?.contains(e.target)) {
                isOpen = false;
                panel?.classList.remove('show');
            }
        });
    });
</script>
