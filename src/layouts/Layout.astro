.meteor:nth-child(6) { top: 48%; animation-duration: calc(var(--meteor-base-duration) * 0.88); animation-delay: -5.8s; }
.meteor:nth-child(7) { top: 60%; animation-duration: calc(var(--meteor-base-duration) * 1.03); animation-delay: -8.4s; }
.meteor:nth-child(8) { top: 72%; animation-duration: calc(var(--meteor-base-duration) * 0.92); animation-delay: -3.7s; }
